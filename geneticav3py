# genotype vertalen naar placeholders voor fenotype
def translateFenotype(genotype):
    if genotype == "aabb":
        feno = "rr"
        return feno
    elif genotype[:1]=="aa" and genotype[2] =="B":
        return "rd"
    elif genotype[2:]=="bb" and genotype[0] == "A":
        return "dr"
    else: 
        return "dd"

# kruisingsschema vullen, ieder genotype naar de vertaler sturen, de placeholders voor fenotype printen in het schema
def schemaTranslate(gametenVader,gametenMoeder):
    print("\033c", end="") # ansi escapecodes om venster leeg te trappen
    print ("fenotype-placeholders printen")
    print()
    kruisingsschema = vulKruisingsschema(gametenVader,gametenMoeder)
    print ("   ", "|", end='')
    for gameet in gametenVader:
        print (" ",gameet, " |", end='')
    print()
    print ("-" * 33)
    for i in range (4):
        print (gametenMoeder[i], " |",end='')
        for j in range (4):
            fenotype=translateFenotype(kruisingsschema[i][j])
            print (fenotype, "   |", end='')
        print()
        print ("-" * 33)


